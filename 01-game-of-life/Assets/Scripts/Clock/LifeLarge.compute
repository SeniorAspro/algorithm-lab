// Game of Life for big loaded patterns (millions of cells), with a zoomable view.
//
// State texture (RG16, 2 bytes per cell):
//   r = alive (1) or dead (0)
//   g = trail: 1 when the cell just died, fades toward 0
//
// The display is screen-sized, not grid-sized: the View kernel looks up which
// cells fall under each screen pixel, so a 7000×7000 grid costs the same to draw
// as a small one.

#pragma kernel Load
#pragma kernel Step
#pragma kernel View

Texture2D<float>    Src;       // the loaded pattern (R8, 1 = alive)
Texture2D<float2>   Prev;      // state we read from
RWTexture2D<float2> Next;      // state we write to
RWTexture2D<float4> Display;   // screen-sized colored output

int Width;           // grid size (pattern + padding)
int Height;
int SrcWidth;        // pattern size
int SrcHeight;
int Pad;             // empty border around the pattern

float TrailDecay;

float2 ViewOrigin;   // grid coordinate under the bottom-left screen pixel
float  CellsPerPixel;
int    DisplayWidth;
int    DisplayHeight;

float4 AliveColor;
float4 DeadColor;
float4 TrailColor;
float4 OutsideColor;

bool InGrid(int2 p) { return p.x >= 0 && p.y >= 0 && p.x < Width && p.y < Height; }

[numthreads(8, 8, 1)]
void Load(uint3 id : SV_DispatchThreadID)
{
    int2 p = int2(id.xy);
    if (!InGrid(p)) return;

    int2 s = p - Pad;
    float alive = (s.x >= 0 && s.y >= 0 && s.x < SrcWidth && s.y < SrcHeight && Src[s] > 0.5) ? 1 : 0;
    Next[p] = float2(alive, 0);
}

[numthreads(8, 8, 1)]
void Step(uint3 id : SV_DispatchThreadID)
{
    int2 p = int2(id.xy);
    if (!InGrid(p)) return;

    int n = 0;
    for (int dx = -1; dx <= 1; dx++)
    for (int dy = -1; dy <= 1; dy++)
    {
        if (dx == 0 && dy == 0) continue;
        int2 q = p + int2(dx, dy);
        if (InGrid(q) && Prev[q].r > 0.5) n++;   // outside the grid counts as dead
    }

    float2 cur = Prev[p];
    bool alive = cur.r > 0.5;
    bool nextAlive = alive ? (n == 2 || n == 3) : (n == 3);
    float trail = (alive && !nextAlive) ? 1.0 : cur.g * TrailDecay;

    Next[p] = float2(nextAlive ? 1 : 0, trail);
}

[numthreads(8, 8, 1)]
void View(uint3 id : SV_DispatchThreadID)
{
    if ((int)id.x >= DisplayWidth || (int)id.y >= DisplayHeight) return;

    float2 corner = ViewOrigin + float2(id.xy) * CellsPerPixel;

    // Zoomed out: one pixel covers many cells. Sample a small block so gliders
    // don't flicker in and out of view, and shade by how many cells are alive.
    int samples = clamp((int)ceil(CellsPerPixel), 1, 8);
    float stride = CellsPerPixel / samples;

    int alive = 0, inside = 0;
    float trail = 0;
    for (int i = 0; i < samples; i++)
    for (int j = 0; j < samples; j++)
    {
        int2 c = int2(floor(corner + float2(i, j) * stride));
        if (!InGrid(c)) continue;
        inside++;
        float2 s = Prev[c];
        if (s.r > 0.5) alive++;
        trail = max(trail, s.g);
    }

    if (inside == 0) { Display[id.xy] = OutsideColor; return; }

    float density = alive / (float)(samples * samples);
    float4 bg = lerp(DeadColor, TrailColor, trail);
    // Boost density when zoomed out so sparse glider streams stay visible.
    float boost = samples > 1 ? 4.0 : 1.0;
    Display[id.xy] = lerp(bg, AliveColor, saturate(density * boost));
}
